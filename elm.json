{
    "type": "package",
    "name": "gampleman/elm-crdt",
    "summary": "Pure-Elm CRDTs: compose records, lists, dicts and text",
    "license": "MIT",
    "version": "1.0.0",
    "exposed-modules": [
        "Crdt",
        "Crdt.Doc",
        "Crdt.Edit",
        "Crdt.Id",
        "Crdt.Cursor",
        "Crdt.Presence",
        "Crdt.Tree",
        "Crdt.RichText"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/core": "1.0.0 <= v < 2.0.0",
        "elm/json": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
